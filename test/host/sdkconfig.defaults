CONFIG_IDF_TARGET="linux"
CONFIG_ASICS_MIN_TIME=1700000000
# kleinster Attribut-Puffer: macht den Probe-Build-Test mit langem Issuer-DN aussagekraeftig
CONFIG_ASICS_ATTRS_BUF_SIZE=512
CONFIG_ASICS_ENABLE_CONSOLE=n
CONFIG_ASICS_SUBJECT_ORG="Test Org"
CONFIG_ASICS_SUBJECT_COUNTRY="DE"
CONFIG_ASICS_TSA_URL="http://tsa.invalid/"

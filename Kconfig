menu "ASiC-S Signer"

    choice ASICS_KEY_BACKEND
        prompt "Schluessel-Backend"
        default ASICS_KEY_BACKEND_NVS
        help
            Legt fest, wo der private ECDSA-P-256-Schluessel liegt. Der private
            Schluessel verlaesst das Backend nie.

        config ASICS_KEY_BACKEND_NVS
            bool "Light: Schluessel im (verschluesselten) NVS"
            help
                Schluessel wird im NVS abgelegt. Gedacht fuer verschluesseltes NVS
                (nvs_keys-Schema, abgesichert durch Flash Encryption) und Secure Boot v2.

        config ASICS_KEY_BACKEND_SE_STUB
            bool "Externes Secure Element / TPM 2.0 (Stub, nicht implementiert)"
            help
                Platzhalter mit identischer Schnittstelle; liefert ESP_ERR_NOT_SUPPORTED.
    endchoice

    config ASICS_NVS_PARTITION
        string "NVS-Partition"
        default "nvs"
        help
            Name der NVS-Partition. Muss von der Anwendung initialisiert werden
            (nvs_flash_init bzw. nvs_flash_secure_init).

    config ASICS_NVS_NAMESPACE
        string "NVS-Namespace"
        default "asics"

    config ASICS_AUTO_GENERATE_KEY
        bool "Schluessel bei Erstinbetriebnahme automatisch erzeugen"
        default y
        help
            asics_signer_init() erzeugt einen Schluessel, falls keiner vorhanden ist.
            Ein vorhandener Schluessel wird niemals ersetzt.

    config ASICS_BOOTLOADER_RANDOM
        bool "bootloader_random_enable() um die Schluesselerzeugung (nur ESP32-Familie)"
        default y
        help
            Der ESP32-RNG liefert nur bei aktivem WLAN/Bluetooth oder aktivierter
            Rauschquelle echte Zufallszahlen. Diese Option schaltet fuer die Dauer
            der Schluesselerzeugung die Rauschquelle ein. Abschalten, falls der ADC
            anderweitig belegt ist oder RF garantiert aktiv ist.

    config ASICS_REQUIRE_FLASH_ENCRYPTION
        bool "Schluesselerzeugung nur bei aktiver Flash Encryption erlauben"
        default y
        depends on ASICS_KEY_BACKEND_NVS
        help
            Schuetzt den NVS-abgelegten Schluessel. Fuer Entwicklungsaufbauten
            abschalten (es wird eine Warnung protokolliert).

    config ASICS_MIN_TIME
        int "Mindest-Zeitpunkt (Unix-Zeit, 0 = Build-Zeitpunkt)"
        default 0
        range 0 4102444800
        help
            Liegt time() darunter, wird nicht signiert (ESP_ERR_INVALID_STATE).
            0 verwendet den Zeitpunkt des CMake-Konfigurationslaufs.

    config ASICS_CERT_MAX_LEN
        int "Maximale Laenge eines Zertifikats (DER, Bytes)"
        default 1024
        range 512 4096

    config ASICS_MAX_CHAIN
        int "Maximale Gesamtzahl Zertifikate (Geraet + CA-Kette)"
        default 4
        range 2 8
        help
            Geraetezertifikat plus 1..(n-1) CA-Zertifikate (Issuing-CA, Zwischen-CAs,
            optional Root). Der Speicher-Blob ist bis zu n * ASICS_CERT_MAX_LEN gross.

    config ASICS_CMS_BUF_SIZE
        int "Puffergroesse fuer die CMS-Signatur (Bytes, Heap)"
        default 5120
        range 1024 16384
        help
            Muss die tatsaechlich importierte Kette fassen: Summe der Zertifikatslaengen
            + ca. 700 Byte Overhead (Worst Case: ASICS_MAX_CHAIN * ASICS_CERT_MAX_LEN + 700).
            Der Import lehnt Ketten ab, die nicht in den Puffer passen (ESP_ERR_NO_MEM).

    config ASICS_ATTRS_BUF_SIZE
        int "Puffergroesse fuer Signed Attributes (Bytes, Heap)"
        default 768
        range 512 4096

    config ASICS_CSR_BUF_SIZE
        int "Puffergroesse fuer den PKCS#10-CSR (Bytes)"
        default 768
        range 384 4096

    config ASICS_PAYLOAD_NAME_MAX
        int "Maximale Laenge des Nutzdatei-Namens"
        default 100
        range 8 255

    config ASICS_WRITE_CHUNK
        int "Maximale Chunk-Groesse pro Schreib-Callback (Bytes)"
        default 4096
        range 64 65536

    config ASICS_SUBJECT_ORG
        string "CSR-Subject: Organisation (O), leer = weglassen"
        default ""

    config ASICS_SUBJECT_COUNTRY
        string "CSR-Subject: Land (C, 2 Buchstaben), leer = weglassen"
        default ""

    config ASICS_ENABLE_CONSOLE
        bool "UART-Konsolenbefehl 'asics' (status/csr/import)"
        default y

endmenu
